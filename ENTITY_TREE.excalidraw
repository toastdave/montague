      "isDeleted": false,
      "boundElements": [],
      "updated": 1777446964737,
      "link": null,
      "locked": false,
      "text": "Key business idea\nJobs define planned work. Crews execute it through Assignments.\nDaily Reports capture reality. Time Entries, Asset Moves, and\nMaintenance Work Orders turn that reality into trackable operations.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Key business idea\nJobs define planned work. Crews execute it through Assignments.\nDaily Reports capture reality. Time Entries, Asset Moves, and\nMaintenance Work Orders turn that reality into trackable operations.",
      "autoResize": false,
      "lineHeight": 1.25
    }
