      "isDeleted": false,
      "boundElements": [],
      "updated": 1777446964737,
      "link": null,
      "locked": false,
      "text": "How to read this\n\u2022 Top-down = primary parent/owner\n\u2022 Lower boxes = child records or linked workflow records\n\u2022 Some entities appear under more than one parent because\n  they are created by one thing but also linked to another",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "How to read this\n\u2022 Top-down = primary parent/owner\n\u2022 Lower boxes = child records or linked workflow records\n\u2022 Some entities appear under more than one parent because\n  they are created by one thing but also linked to another",
      "autoResize": false,
      "lineHeight": 1.25
    },
